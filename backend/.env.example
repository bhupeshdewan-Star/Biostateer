# Biostateer™ Validation Engine Configuration Example
# Copy this file to .env and configure for your local environment.
# DO NOT COMMIT ACTUAL SECRETS TO SOURCE CONTROL.

# Application Environment (development / staging / production)
ENV=production
LOG_LEVEL=info

# Service Port
API_PORT=8000

# Security and Sessions
SESSION_TIMEOUT=3600
# JWT Secret Key - Change this in production!
JWT_SECRET=super_secret_cryptographic_key_replace_this_for_production
# Authorized CORS Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Regulatory Storage Data Paths
AUDIT_LOG_PATH=/data/audit
VALIDATION_REGISTRY_PATH=/data/validation

# Database Configuration (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=biostateer_db
DB_USER=biostat_admin
DB_PASSWORD=secure_biostat_admin_db_password_change_me
